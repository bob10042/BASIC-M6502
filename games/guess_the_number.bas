10 REM GUESS THE NUMBER
20 REM Classic number guessing game
30 REM Public domain - 1970s era
40 REM
50 PRINT "================================"
60 PRINT "    GUESS THE NUMBER GAME"
70 PRINT "================================"
80 PRINT
90 PRINT "I'M THINKING OF A NUMBER"
100 PRINT "BETWEEN 1 AND 100."
110 PRINT
120 N = INT(RND(1) * 100) + 1
130 C = 0
140 REM
150 REM MAIN GAME LOOP
160 PRINT
170 INPUT "YOUR GUESS"; G
180 C = C + 1
190 IF G = N THEN GOTO 300
200 IF G < N THEN PRINT "TOO LOW! TRY AGAIN."
210 IF G > N THEN PRINT "TOO HIGH! TRY AGAIN."
220 GOTO 160
230 REM
300 REM WINNER!
310 PRINT
320 PRINT "CONGRATULATIONS!"
330 PRINT "YOU GUESSED IT IN"; C; "TRIES."
340 PRINT
350 INPUT "PLAY AGAIN (Y/N)"; A$
360 IF A$ = "Y" OR A$ = "y" THEN GOTO 120
370 PRINT "THANKS FOR PLAYING!"
380 END
